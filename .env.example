# Spotify Developer Credentials
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# Spotify OAuth (populated by running: npm run auth)
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional Pipeline Flags
INCLUDE_FOLLOWED=false

# Frontend Build (e.g. /Speed_Song/ for GitHub Pages project site)
VITE_BASE=/

# Cloudflare R2 Object Storage (for hosting 0:00-0:30 audio intro snippets)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=speed-song-audio
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxx.r2.dev
