{
  "name": "speed-song",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/verify-e2e.ts",
    "auth": "tsx --env-file=.env scripts/data/auth.ts",
    "sync:playlists": "tsx --env-file=.env scripts/data/sync-playlists.ts",
    "data:build": "tsx --env-file=.env scripts/data/index.ts",
    "data:check": "tsx --env-file=.env scripts/data/check-previews.ts",
    "data:ingest": "tsx --env-file=.env scripts/data/ingest-intro.ts",
    "data:update": "tsx --env-file=.env scripts/data/update-all.ts",
    "data:count": "tsx --env-file=.env scripts/data/count-bucket.ts",
    "data:throttle": "tsx scripts/data/test-throttle.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@types/node": "^22.13.9",
    "playwright": "^1.64.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.0.3"
  }
}
